# Spotify API Credentials (optional - not currently used)
# Get these from https://developer.spotify.com/dashboard
REACT_APP_SPOTIFY_CLIENT_ID=your_client_id_here
REACT_APP_SPOTIFY_CLIENT_SECRET=your_client_secret_here
REACT_APP_REDIRECT_URI=http://localhost:8080/callback

# Use local credentials instead of AWS
REACT_APP_USE_AWS_AUTH=false

# Server Configuration
PORT=3001
NODE_ENV=development

# Socket.io URL
# Voor local development
SOCKET_URL=http://localhost:3001
# Voor production (vervang met je Render.com URL)
# SOCKET_URL=https://your-app-name.onrender.com
